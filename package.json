{
  "name": "hp-dfr",
  "version": "0.1.0",
  "private": true,
  "description": "Goal-Oriented Deep Fourier Residual methods for solving PDEs with neural networks",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "docs:dev": "yarn workspace @hp-dfr/docs dev",
    "docs:build": "yarn workspace @hp-dfr/docs build",
    "docs:serve": "yarn workspace @hp-dfr/docs serve",
    "docs:nuke": "yarn workspace @hp-dfr/docs nuke",
    "infra:synth": "yarn workspace @hp-dfr/infra cdk synth",
    "infra:build": "yarn workspace @hp-dfr/infra build",
    "infra:deploy": "yarn workspace @hp-dfr/infra cdk deploy --all",
    "infra:destroy": "yarn workspace @hp-dfr/infra cdk destroy --all",
    "infra:test": "yarn workspace @hp-dfr/infra test",
    "infra:nuke": "yarn workspace @hp-dfr/infra nuke",
    "lint": "eslint packages/docs/src packages/infra/lib packages/infra/bin",
    "lint:fix": "eslint --fix packages/docs/src packages/infra/lib packages/infra/bin",
    "format": "prettier --check \"packages/**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:fix": "prettier --write \"packages/**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "yarn docs:build && yarn infra:build",
    "nuke": "yarn docs:nuke && yarn infra:nuke && rm -rf node_modules yarn.lock"
  },
  "keywords": [
    "pinns",
    "physics-informed-neural-networks",
    "deep-fourier-residual",
    "pde",
    "machine-learning"
  ],
  "author": "Carlos Vera-Ciro <caverac@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "yarn@4.12.0",
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.0.3",
    "@semantic-release/git": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.33.0",
    "@typescript-eslint/parser": "^8.33.0",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.2.0",
    "prettier": "^3.5.3",
    "semantic-release": "^24.2.0",
    "typescript": "^5.9.3"
  }
}
