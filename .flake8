[flake8]
max-line-length = 140
extend-ignore =
    # E203: whitespace before ':' (conflicts with black)
    E203,
    # E501: line too long (handled by black)
    E501,
    # W503: line break before binary operator (conflicts with black)
    W503,
exclude =
    .git,
    .eggs,
    .mypy_cache,
    .pytest_cache,
    .venv,
    __pycache__,
    build,
    dist,
    data,
per-file-ignores =
    # Allow unused imports in __init__.py
    __init__.py:F401
    # Allow assert in tests
    tests/*:S101
