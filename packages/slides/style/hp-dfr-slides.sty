% Shared style for the Goal-Oriented DFR lecture deck.
%
% A minimal, sober Beamer configuration: navy / slate / sky accents,
% sans-serif body, no clutter. No external theme dependency. Adapted from the
% author's symmetry-aware-optimization slide style.

\ProvidesPackage{hp-dfr-slides}[2026/07/20 Goal-Oriented DFR slide style]

\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{lmodern}
\RequirePackage{microtype}
\RequirePackage{xcolor}
\RequirePackage{tikz}
\RequirePackage{amsmath,amssymb}
\RequirePackage{booktabs}
\RequirePackage{hyperref}
\usetikzlibrary{positioning,arrows.meta,shapes.geometric,fit,calc,decorations.pathreplacing,backgrounds}

% -- Palette --------------------------------------------------------------------
\definecolor{ink}{HTML}{1F2937}
\definecolor{neutral}{HTML}{475569}
\definecolor{muted}{HTML}{94A3B8}
\definecolor{paper}{HTML}{F8FAFC}
\definecolor{accent}{HTML}{0EA5E9}
\definecolor{accentdark}{HTML}{0369A1}
\definecolor{danger}{HTML}{DC2626}
\definecolor{warn}{HTML}{D97706}
\definecolor{success}{HTML}{16A34A}
\definecolor{soft}{HTML}{E2E8F0}

\hypersetup{colorlinks=true, linkcolor=accentdark, urlcolor=accentdark, citecolor=accentdark}

% -- Beamer theme ---------------------------------------------------------------
\usetheme{default}
\useinnertheme{rectangles}
\useoutertheme{infolines}

\setbeamercolor{normal text}{fg=ink, bg=white}
\setbeamercolor{structure}{fg=accentdark}
\setbeamercolor{frametitle}{fg=ink, bg=white}
\setbeamercolor{title}{fg=ink, bg=white}
\setbeamercolor{subtitle}{fg=neutral, bg=white}
\setbeamercolor{author}{fg=neutral}
\setbeamercolor{institute}{fg=muted}
\setbeamercolor{date}{fg=muted}
\setbeamercolor{itemize item}{fg=accent}
\setbeamercolor{itemize subitem}{fg=accent}
\setbeamercolor{itemize subsubitem}{fg=accent}
\setbeamercolor{enumerate item}{fg=accent}
\setbeamercolor{block title}{fg=white, bg=accentdark}
\setbeamercolor{block body}{fg=ink, bg=soft}
\setbeamercolor{alerted text}{fg=danger}
\setbeamercolor{example text}{fg=success}
\setbeamercolor{footnote}{fg=muted}
\setbeamercolor{footnote mark}{fg=muted}
\setbeamercolor{section in head/foot}{fg=neutral, bg=white}
\setbeamercolor{title in head/foot}{fg=neutral, bg=white}
\setbeamercolor{author in head/foot}{fg=neutral, bg=white}
\setbeamercolor{date in head/foot}{fg=neutral, bg=white}

\setbeamerfont{frametitle}{series=\bfseries, size=\large}
\setbeamerfont{title}{series=\bfseries, size=\LARGE}
\setbeamerfont{subtitle}{series=\mdseries, size=\large, shape=\itshape}
\setbeamerfont{author}{size=\normalsize}
\setbeamerfont{block title}{series=\bfseries}
\setbeamerfont{section in head/foot}{size=\small}
\setbeamerfont{footline}{size=\scriptsize}

\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{itemize items}[circle]
\setbeamertemplate{enumerate items}[default]
\setbeamertemplate{headline}{}
\setbeamertemplate{frametitle}{%
  \nointerlineskip%
  \begin{beamercolorbox}[wd=\paperwidth,leftskip=0.6cm,rightskip=0.6cm,ht=0.55cm,dp=0.15cm]{frametitle}%
    \usebeamerfont{frametitle}\insertframetitle%
  \end{beamercolorbox}%
  \vskip-2pt%
  \hspace{0.6cm}\color{soft}\rule{\dimexpr\paperwidth-1.2cm\relax}{0.5pt}%
}

\setbeamertemplate{footline}{%
  \leavevmode%
  \hbox{%
    \begin{beamercolorbox}[wd=.45\paperwidth,ht=2.25ex,dp=1ex,leftskip=0.6cm]{title in head/foot}%
      \usebeamerfont{footline}\inserttitle%
    \end{beamercolorbox}%
    \begin{beamercolorbox}[wd=.45\paperwidth,ht=2.25ex,dp=1ex,leftskip=0.6cm]{section in head/foot}%
      \usebeamerfont{footline}\insertsection%
    \end{beamercolorbox}%
    \begin{beamercolorbox}[wd=.1\paperwidth,ht=2.25ex,dp=1ex,rightskip=0.6cm]{date in head/foot}%
      \hfill\usebeamerfont{footline}\insertframenumber{}\,/\,\inserttotalframenumber%
    \end{beamercolorbox}%
  }%
}

\setbeamertemplate{section page}{%
  \begin{centering}
    \vfill
    {\color{muted}\small Section \insertsectionnumber\par}
    \vskip 0.5em
    {\color{ink}\Large\bfseries\insertsectionhead\par}
    \vfill
  \end{centering}
}
\AtBeginSection[]{%
  \begin{frame}[plain,noframenumbering]%
    \sectionpage
  \end{frame}%
}

% -- TikZ helpers ---------------------------------------------------------------
\tikzset{
  opnode/.style={
    draw=neutral, thick, rounded corners=3pt,
    fill=soft, minimum width=24mm, minimum height=9mm,
    font=\small, align=center
  },
  accentnode/.style={opnode, fill=accent!12, draw=accent},
  goodnode/.style={opnode, fill=success!12, draw=success},
  badnode/.style={opnode, fill=danger!8, draw=danger},
  localarrow/.style={-Latex, thick, neutral},
  dashedarrow/.style={-Latex, very thick, dashed, accentdark},
  caption/.style={font=\small\itshape, color=neutral},
  % neuron/layer primitives for small network schematics
  neuron/.style={circle, draw=neutral, fill=paper, minimum size=5.5mm, inner sep=0pt},
  inneuron/.style={neuron, fill=accent!20, draw=accent},
  outneuron/.style={neuron, fill=success!20, draw=success},
  netedge/.style={draw=soft, line width=0.3pt}
}

% -- Callout box ----------------------------------------------------------------
% \takeaway{...} for the one-line "what to remember" at the foot of a slide.
\newcommand{\takeaway}[1]{%
  \vfill
  \begin{beamercolorbox}[wd=\textwidth,sep=6pt,rounded=true]{block body}%
    \small\important{Takeaway:}\ #1%
  \end{beamercolorbox}%
}

% -- Text macros ----------------------------------------------------------------
\newcommand{\important}[1]{\textcolor{accentdark}{\textbf{#1}}}
\renewcommand{\alert}[1]{\textcolor{danger}{\textbf{#1}}}
\newcommand{\good}[1]{\textcolor{success}{\textbf{#1}}}
\newcommand{\code}[1]{\texttt{\small #1}}

% -- Theorem environments (Beamer predefines theorem/corollary/definition) -----
\newtheorem{proposition}{Proposition}

% -- Math macros (matching the paper) ------------------------------------------
\newcommand{\R}{\mathbb{R}}
\newcommand{\norm}[1]{\left\|#1\right\|}
\newcommand{\inner}[2]{\left\langle #1, #2 \right\rangle}
\newcommand{\Res}{R}          % primal residual
\newcommand{\Resad}{R^{*}}    % adjoint residual
\newcommand{\QoI}{\mathcal{L}_{\mathrm{QoI}}}
